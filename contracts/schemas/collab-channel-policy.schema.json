{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.signal.design/schemas/collab-channel-policy.schema.json",
  "title": "CollabChannelPolicy",
  "description": "Module: collab-channel-policy.schema.json | Invariants: 5-team Zero-Leak collaboration, required_repo_scopes RBAC masking, PQC DEK encryption | Spec: 21",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channel_id",
    "team_space",
    "required_repo_scopes",
    "allow_viewport_huddle",
    "retention_days"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "channel_id": { "type": "string", "format": "uuid" },
    "team_space": {
      "type": "string",
      "enum": ["DESIGN", "DEVELOPMENT_BRINGUP", "SOFTWARE_FIRMWARE", "MANUFACTURING", "OPERATIONS_SUPPLY_CHAIN"]
    },
    "required_repo_scopes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "allow_viewport_huddle": { "type": "boolean" },
    "retention_days": { "type": "integer", "minimum": 1, "maximum": 3650 }
  }
}
