# Module: infra/local/env/ai-llm.env.example — Local Mac Ollama / MLX & Deterministic Mock LLM Env Template
# Invariants: Auto-falls back to deterministic_mock when offline or in headless CI; keeps Zero-Tool Quarantine active (F-143).
# Spec: architecture/05-ai-agent-and-datasheet-rag.md, architecture/09-local-development-environment.md
SIGNAL_LLM_PROVIDER=auto_ollama_or_deterministic_mock
SIGNAL_OLLAMA_BASE_URL=http://127.0.0.1:11434
SIGNAL_OLLAMA_MODEL=qwen2.5-coder:7b
SIGNAL_QUARANTINE_ZERO_TOOLS=1
SIGNAL_GBNF_STRICT_DECODING=1
