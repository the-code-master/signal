# Module: infra/local/env/data.env.example — PostgreSQL 19+ RLS, Valkey, NATS & MinIO Local Env Template
# Invariants: Connects FastAPI via NOBYPASSRLS role `signal_app_rls` (never superuser at runtime, F-084).
# Spec: architecture/09-local-development-environment.md, architecture/15-application-security-and-project-isolation.md
SIGNAL_DATABASE_URL=postgresql+asyncpg://signal_app_rls:signal_rls_dev_only@127.0.0.1:5432/signal_control_plane
SIGNAL_VALKEY_URL=redis://127.0.0.1:6379/0
SIGNAL_NATS_URL=nats://127.0.0.1:4222
SIGNAL_S3_ENDPOINT_URL=http://127.0.0.1:9000
