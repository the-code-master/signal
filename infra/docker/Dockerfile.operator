# Module: infra/docker/Dockerfile.operator — Tier-3 Multi-Version Kubernetes 1.37+ Cell Reconciler
# Invariants: --no-default-features; distroless UID 65532; reconciles 1-4 -> N pool-rust-engine worker nodes (20-*).
# Spec: architecture/04-kubernetes-runtime-and-collaboration.md, architecture/20-versioning-release-monorepo-build-and-k8s-topology.md
FROM rust:1.100-bookworm AS build
ARG SIGNAL_VERSION=0.1.0
ARG SIGNAL_FORBID_DEV_AUTH=1
RUN test "${SIGNAL_FORBID_DEV_AUTH}" = "1" && apt-get update && apt-get install -y --no-install-recommends protobuf-compiler && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY rust-toolchain.toml VERSION ./
COPY contracts ./contracts
COPY engine ./engine
RUN cargo build --manifest-path engine/Cargo.toml --release --no-default-features -p signal-operator

FROM gcr.io/distroless/cc-debian12:nonroot AS runtime
ARG SIGNAL_VERSION=0.1.0
ENV SIGNAL_VERSION=${SIGNAL_VERSION}
USER 65532:65532
EXPOSE 8081
